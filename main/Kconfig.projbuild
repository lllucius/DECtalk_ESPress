menu "DECtalk ESPress Firmware"

    menu "Audio output"
        choice DTESP_DAC_TYPE
            prompt "Audio DAC"
            default DTESP_DAC_GENERIC
            help
                Select the audio DAC or amplifier board connected to the
                I2S output.

            config DTESP_DAC_GENERIC
                bool "Generic I2S DAC (MAX98357A, PCM5102, etc.)"
                help
                    Simple I2S DAC or amplifier that requires no I2C
                    configuration.  Suitable for MAX98357A, PCM5102,
                    and similar boards that derive their clocks from
                    BCLK and WS alone.

            config DTESP_DAC_TLV320
                bool "Adafruit TLV320DAC3100 breakout"
                help
                    TI TLV320DAC3100 stereo DAC with headphone amplifier
                    and class-D speaker output (Adafruit breakout board).
                    Requires I2C for register configuration.  When MCLK
                    is wired the codec uses it directly; otherwise the
                    driver locks the codec PLL from BCLK.
        endchoice

        config DTESP_I2S_BCK_GPIO
            int "I2S BCK GPIO"
            default 21
            range 0 48
            help
                GPIO used for the I2S bit clock output.

        config DTESP_I2S_WS_GPIO
            int "I2S WS GPIO"
            default 20
            range 0 48
            help
                GPIO used for the I2S word select / LRCK output.

        config DTESP_I2S_DO_GPIO
            int "I2S data out GPIO"
            default 19
            range 0 48
            help
                GPIO used for the I2S serial data output.

        config DTESP_I2S_MCLK_GPIO
            int "I2S MCLK GPIO (-1 to disable)"
            default -1
            range -1 48
            help
                GPIO used to output the I2S master clock (MCLK) to the
                codec.  Set to -1 when MCLK is not wired; in that case the
                TLV320DAC3100 driver enables its internal PLL and derives
                CODEC_CLKIN from BCLK instead.

                When a valid GPIO is selected, the ESP32 emits MCLK at
                256 x Fs and the codec is configured with CODEC_CLKIN =
                MCLK (no PLL).  This produces a cleaner and in-spec DAC
                modulator clock, which helps at low sample rates such as
                11025 Hz where BCLK alone is far below the codec's
                minimum DAC_MOD_CLK of ~2.8 MHz.

                Only has an effect when DTESP_DAC_TLV320 is
                selected; the generic DAC path does not require MCLK.

        config DTESP_I2C_SDA_GPIO
            int "I2C SDA GPIO"
            default 18
            range 0 48
            depends on DTESP_DAC_TLV320
            help
                GPIO used for the I2C data line to the TLV320DAC3100.

        config DTESP_I2C_SCL_GPIO
            int "I2C SCL GPIO"
            default 9
            range 0 48
            depends on DTESP_DAC_TLV320
            help
                GPIO used for the I2C clock line to the TLV320DAC3100.

        config DTESP_TLV320_I2C_ADDR
            hex "TLV320DAC3100 I2C address"
            default 0x18
            depends on DTESP_DAC_TLV320
            help
                7-bit I2C address of the TLV320DAC3100.  The Adafruit
                breakout board defaults to 0x18.

        config DTESP_CODEC_INT_GPIO
            int "TLV320DAC3100 interrupt GPIO"
            default 15
            range -1 48
            depends on DTESP_DAC_TLV320
            help
                MCU GPIO connected to the TLV320DAC3100 interrupt output.

                Set this to -1 when the codec interrupt pin is not wired.
                When enabled, the firmware configures the GPIO as an
                interrupt-capable input and defers codec register reads to a
                task context.

        config DTESP_CODEC_RESET_GPIO
            int "TLV320DAC3100 reset GPIO"
            default 22
            range -1 48
            depends on DTESP_DAC_TLV320
            help
                MCU GPIO connected to the TLV320DAC3100 active-low reset pin.

                Set this to -1 when the reset pin is tied to the board's power
                rail or is otherwise unused.  When enabled, the firmware drives
                a hardware reset pulse before codec register configuration.

        menu "TLV320DAC3100 defaults"
            depends on DTESP_DAC_TLV320

            comment "Tone-shaping / DSP defaults."

            choice DTESP_TLV320_DEFAULT_PROFILE
                prompt "Default output profile"
                default DTESP_TLV320_DEFAULT_PROFILE_SPEAKER
                help
                    Factory-default startup output profile used when NVS does
                    not yet contain a saved value.  The runtime profile can
                    be changed with [:fw profile speaker|headphone] and
                    persisted with [:fw save].

                config DTESP_TLV320_DEFAULT_PROFILE_SPEAKER
                    bool "Speaker"

                config DTESP_TLV320_DEFAULT_PROFILE_HEADPHONE
                    bool "Headphone"
            endchoice

            config DTESP_TLV320_HEADSET_AUTOSWITCH
                bool "Enable headset auto-switching"
                default y
                help
                    Factory-default for the headset auto-switch flag.  When
                    on, the codec polls jack detect and switches between
                    speaker and headphone profiles automatically.

                    The runtime value can be changed with
                    [:fw autoswitch on|off] and persisted with [:fw save].

            config DTESP_TLV320_STARTUP_VOLUME
                int "Startup digital volume"
                range 0 9
                default 5
                help
                    Factory-default startup digital volume (0 = near mute,
                    9 = 0 dB).  Used when NVS does not yet contain a saved
                    volume.  Change the runtime value with
                    [:fw volume <0..9>] and persist with [:fw save].

            config DTESP_TLV320_DSP_ENABLE
                bool "Enable on-chip DSP / EQ support"
                default y
                help
                    Compile in the TLV320 DSP module and the associated
                    [:fw bass], [:fw treble], [:fw eq ...], [:fw drc ...]
                    and [:fw spkgain ...] commands.  With the module off
                    the codec is configured in PRB_P1 (basic processing
                    block, no EQ, no DRC) and the commands are stubs that
                    only log.  Leaving this on at default settings has no
                    audible effect — tone controls are applied lazily when
                    the user invokes a command.

            choice DTESP_TLV320_DEFAULT_PRESET
                prompt "Default DSP preset at first boot"
                depends on DTESP_TLV320_DSP_ENABLE
                default DTESP_TLV320_DEFAULT_PRESET_FLAT
                help
                    Preset loaded into the DSP state when no NVS blob
                    exists yet.  "flat" matches the pre-DSP-feature
                    behaviour (no EQ, no DRC) and is the recommended
                    first-boot default.

                    Quick glossary for the non-flat presets:

                    * speech — gentle low-shelf cut at ~200 Hz (fixes
                      "muddy" boxy sound on small speakers), a small
                      peaking cut around 500 Hz, and a presence boost
                      around 3 kHz with a slight treble lift at 4.5 kHz
                      plus mild DRC.  This is the recommended starting
                      point for DECtalk TTS.

                    * crisp — more aggressive 3 kHz + 5 kHz boost for
                      users who need extra intelligibility.

                    * warm — gentle bass lift, no treble boost for users
                      who find crisp too sibilant.

                config DTESP_TLV320_DEFAULT_PRESET_FLAT
                    bool "flat (no EQ, no DRC)"

                config DTESP_TLV320_DEFAULT_PRESET_SPEECH
                    bool "speech (default TTS tuning)"

                config DTESP_TLV320_DEFAULT_PRESET_CRISP
                    bool "crisp"

                config DTESP_TLV320_DEFAULT_PRESET_WARM
                    bool "warm"
            endchoice

            config DTESP_TLV320_DRC_DEFAULT
                bool "Enable DRC at first boot"
                depends on DTESP_TLV320_DSP_ENABLE
                default n
                help
                    Factory-default for the DRC enable flag.  DRC
                    (Dynamic Range Compression) makes TTS sound
                    consistently louder without clipping, at the cost
                    of some dynamic range.  The runtime value is
                    changed with [:fw drc on|off].

            choice DTESP_TLV320_DEFAULT_SPK_GAIN
                prompt "Default class-D speaker gain (dB)"
                default DTESP_TLV320_DEFAULT_SPK_GAIN_6
                help
                    Analog gain applied at the class-D speaker
                    amplifier stage.  6 dB matches the pre-feature
                    firmware default.  Higher values drive small 8 Ω
                    speakers louder without pushing digital volume
                    into clip, at the cost of noise floor.  The
                    runtime value is changed with [:fw spkgain
                    6|12|18|24] and persisted with [:fw save].

                config DTESP_TLV320_DEFAULT_SPK_GAIN_6
                    bool "6 dB (default)"

                config DTESP_TLV320_DEFAULT_SPK_GAIN_12
                    bool "12 dB"

                config DTESP_TLV320_DEFAULT_SPK_GAIN_18
                    bool "18 dB"

                config DTESP_TLV320_DEFAULT_SPK_GAIN_24
                    bool "24 dB"
            endchoice

            config DTESP_TLV320_DEFAULT_SPK_GAIN_DB
                int
                default 6 if DTESP_TLV320_DEFAULT_SPK_GAIN_6
                default 12 if DTESP_TLV320_DEFAULT_SPK_GAIN_12
                default 18 if DTESP_TLV320_DEFAULT_SPK_GAIN_18
                default 24 if DTESP_TLV320_DEFAULT_SPK_GAIN_24
        endmenu

        menu "Analog volume knob (potentiometer)"
            config DTESP_VOLUME_KNOB_ENABLE
                bool "Enable analog volume potentiometer"
                depends on DTESP_DAC_TLV320
                default n
                help
                    Sample an analog potentiometer via ADC and drive the
                    TLV320DAC3100 digital volume from it.  The codec
                    volume remains the single source of truth; the pot
                    and [:fw volume ...] coexist via a "soft takeover"
                    scheme so neither can cause abrupt jumps.

                    When disabled, no ADC hardware is initialised and
                    the module compiles out.

            config DTESP_VOLUME_KNOB_GPIO
                int "Volume knob ADC GPIO"
                depends on DTESP_VOLUME_KNOB_ENABLE
                default 6
                range 0 6
                help
                    GPIO the potentiometer wiper is connected to.  On
                    ESP32-C6 only GPIO0..GPIO6 are usable ADC inputs
                    (ADC1 channels 0..6).  Default is GPIO6.

            config DTESP_VOLUME_KNOB_POLL_MS
                int "ADC poll period (ms)"
                depends on DTESP_VOLUME_KNOB_ENABLE
                default 25
                range 5 500
                help
                    How often the pot is sampled.  25 ms gives a
                    responsive feel without spamming the codec over
                    I2C on every tiny pot movement.

            config DTESP_VOLUME_KNOB_AVG_SAMPLES
                int "Moving-average window (samples)"
                depends on DTESP_VOLUME_KNOB_ENABLE
                default 8
                range 1 64
                help
                    Number of raw ADC readings combined into the
                    filtered value used for quantisation.  Larger
                    values give a smoother response at the cost of
                    extra latency (window * poll_ms).

            config DTESP_VOLUME_KNOB_LATCH_WINDOW
                int "Soft-takeover latch window (steps)"
                depends on DTESP_VOLUME_KNOB_ENABLE
                default 1
                range 0 9
                help
                    After a firmware volume command, the pot stays
                    "unlatched" and its readings are ignored until the
                    pot-derived step is within ±this many steps of the
                    current actual volume.  1 keeps the soft-takeover
                    tight; 0 requires an exact match before latching.

            config DTESP_VOLUME_KNOB_HYSTERESIS
                int "Step-boundary hysteresis (ADC counts)"
                depends on DTESP_VOLUME_KNOB_ENABLE
                default 40
                range 0 1000
                help
                    Minimum change in filtered ADC counts required to
                    cross from one discrete volume step to the next.
                    Prevents flapping when the pot sits exactly at a
                    boundary.  Raise this if the volume ever jumps
                    between two adjacent steps at rest.

            config DTESP_VOLUME_KNOB_ADC_MIN
                int "ADC endpoint calibration: minimum count"
                depends on DTESP_VOLUME_KNOB_ENABLE
                default 0
                range 0 4095
                help
                    Raw ADC reading that should map to volume 0.  Leave
                    at 0 unless the pot's low end does not reach the
                    true ADC floor.

            config DTESP_VOLUME_KNOB_ADC_MAX
                int "ADC endpoint calibration: maximum count"
                depends on DTESP_VOLUME_KNOB_ENABLE
                default 4095
                range 1 4095
                help
                    Raw ADC reading that should map to volume 9.  With
                    ADC_ATTEN_DB_12 the codec's ~3.3 V rail typically
                    produces readings close to 4095 at the pot's upper
                    stop; lower this value if the top of travel does
                    not reach 9.
        endmenu

        menu "Advanced audio tuning"
            config DTESP_I2S_DMA_DESC_NUM
                int "I2S DMA descriptor count"
                default 8
                range 2 32
                help
                    Number of DMA descriptors allocated for I2S playback.

            config DTESP_I2S_DMA_FRAME_NUM
                int "I2S DMA frame count"
                default 256
                range 64 1024
                help
                    Number of audio frames per I2S DMA descriptor.
        endmenu
    endmenu

    menu "Runtime tuning"
        config DTESP_TEXT_BUFFER_SIZE
            int "Protocol text buffer size"
            default 2048
            range 256 8192
            help
                Maximum number of text bytes buffered before they are queued
                for synthesis.

        config DTESP_SPEECH_QUEUE_SIZE
            int "Speech queue depth"
            default 32
            range 4 128
            help
                Number of queued text chunks allowed before host flow control
                starts throttling input.

        config DTESP_RX_TIMEOUT_MS
            int "Serial RX timeout (ms)"
            default 10
            range 1 1000
            help
                Timeout used when polling the serial receive buffer.

        config DTESP_TEXT_IDLE_TIMEOUT_MS
            int "Buffered text idle flush timeout (ms)"
            default 200
            range 10 5000
            help
                Flush buffered text to the speech queue if no new characters
                arrive within this interval.

        menu "Advanced task tuning"
            config DTESP_SPEECH_TASK_CORE
                int "Speech task core"
                default 1 if SOC_CPU_CORES_NUM > 1
                default 0
                range 0 1 if SOC_CPU_CORES_NUM > 1
                range 0 0
                help
                    CPU core used for the speech synthesis thread.
                    On single-core chips this is fixed to core 0.

            config DTESP_MAIN_TASK_STACK_SIZE
                int "Main ESPress pthread stack size"
                default 12288
                range 4096 32768
                help
                    Stack size for the ESPress protocol thread created from
                    app_main().
        endmenu
    endmenu

    menu "USB CDC transport"
        visible if !IDF_TARGET_ESP32C6
        config DTESP_CDC_RX_STREAM_SIZE
            int "CDC RX stream buffer size"
            default 4096
            range 256 16384
            help
                Size of the FreeRTOS stream buffer that bridges TinyUSB RX to
                the ESPress protocol task.
    endmenu

    menu "JTAG serial transport"
        visible if IDF_TARGET_ESP32C6
        config DTESP_JTAG_RX_BUF_SIZE
            int "JTAG serial RX buffer size"
            default 4096
            range 256 16384
            help
                Size of the ring buffer for USB Serial/JTAG receive data.

        config DTESP_JTAG_TX_BUF_SIZE
            int "JTAG serial TX buffer size"
            default 4096
            range 256 16384
            help
                Size of the ring buffer for USB Serial/JTAG transmit data.
    endmenu

    menu "Onboard RGB LED"
        config DTESP_DISABLE_RGB_LED
            bool "Disable onboard RGB LED"
            default n
            help
                Many ESP32 development boards include an onboard addressable
                RGB LED (WS2812 / SK6812).  Enable this option to drive the
                LED data GPIO low at startup, keeping the LED dark.

                Not all boards have an RGB LED, so this option is disabled
                by default.

        config DTESP_RGB_LED_GPIO
            int "RGB LED data GPIO"
            depends on DTESP_DISABLE_RGB_LED
            default 8  if IDF_TARGET_ESP32C6
            default 18 if IDF_TARGET_ESP32S2
            default 48
            range 0 48
            help
                GPIO connected to the onboard addressable RGB LED data input.

                Common defaults:
                  ESP32-C6  – GPIO 8
                  ESP32-S2  – GPIO 18
                  ESP32-S3  – GPIO 48
    endmenu

    menu "Custom firmware commands"
        config DTESP_FW_CMD_ENABLE
            bool "Enable [:fw ...] custom commands"
            default y
            help
                Parse and intercept [:fw ...] tokens in input text.
                When disabled, all bracket-colon tokens pass through
                to DECtalk unchanged.

        config DTESP_FW_CMD_NAMESPACE
            string "Custom command namespace"
            default "fw"
            depends on DTESP_FW_CMD_ENABLE
            help
                The keyword that follows [: to identify a firmware
                custom command (e.g. "fw" matches [:fw ...]).

        config DTESP_FW_CMD_MAX_TOKEN_LEN
            int "Max custom command token length"
            default 128
            range 32 512
            depends on DTESP_FW_CMD_ENABLE
            help
                Maximum number of characters between [: and ] for a
                custom command.  Tokens longer than this are consumed
                and logged as oversized.

        config DTESP_FW_CMD_MAX_ARGS
            int "Max custom command argument count"
            default 8
            range 2 32
            depends on DTESP_FW_CMD_ENABLE
            help
                Maximum number of whitespace-delimited arguments in
                a single custom command (including the sub-command name).

        config DTESP_FW_CMD_ALLOW_NATIVE_OVERRIDE
            bool "Allow native DECtalk command override"
            default n
            depends on DTESP_FW_CMD_ENABLE
            help
                When enabled, custom command handlers may intercept
                tokens that would otherwise be native DECtalk inline
                commands.  Default is off: only [:fw ...] tokens
                are intercepted.

        config DTESP_FW_CMD_GPIO_ENABLE
            bool "Enable GPIO handler"
            default y
            depends on DTESP_FW_CMD_ENABLE
            help
                Enable the [:fw gpio <pin> <on|off|0|1>] handler.

        config DTESP_FW_CMD_TONE_ENABLE
            bool "Enable tone handler"
            default n
            depends on DTESP_FW_CMD_ENABLE
            help
                Enable the [:fw tone <freq_hz> <duration_ms>] handler.
                When enabled and DTESP_TONE_GPIO is configured, produces
                a square-wave tone via the LEDC PWM peripheral.

        config DTESP_TONE_GPIO
            int "Tone output GPIO (-1 to disable)"
            default -1
            range -1 48
            depends on DTESP_FW_CMD_TONE_ENABLE
            help
                GPIO connected to a piezo buzzer or small speaker for tone
                generation via LEDC PWM.  Set to -1 to disable hardware
                tone output (the handler will only log the request).

        config DTESP_FW_CMD_DSP_ENABLE
            bool "Enable DSP / EQ / DRC / tone / mute commands"
            default y
            depends on DTESP_FW_CMD_ENABLE
            depends on DTESP_DAC_TLV320
            help
                Enable the on-chip-DSP-backed [:fw ...] sub-commands:
                bass, treble, eq, drc, spkgain and mute.  Requires the
                TLV320DAC3100 driver; on other DACs the commands are
                stripped out at compile time.

                Leave enabled unless you need to shave a few hundred
                bytes of flash on a minimal build.

        config DTESP_FW_CMD_RESET_ON_RECONNECT
            bool "Reset custom command state on reconnect"
            default y
            depends on DTESP_FW_CMD_ENABLE
            help
                Clear session-level custom command state (e.g. stored
                voice and rate overrides) when the USB host reconnects.
    endmenu

    menu "Diagnostics and logging"
        config DTESP_ENABLE_DIAG_MEM
            bool "Enable heap and stack diagnostics"
            default n
            select FREERTOS_USE_TRACE_FACILITY
            help
                Start a low-priority background task that periodically logs
                per-task stack high-water marks together with heap usage and
                fragmentation statistics.

                Disable this option to remove the diagnostic task entirely
                when you want the quietest runtime logging or the lowest
                possible overhead.

        config DTESP_DIAG_MEM_INTERVAL_MS
            int "Diagnostics print interval (ms)"
            depends on DTESP_ENABLE_DIAG_MEM
            range 1000 600000
            default 10000
            help
                How often the diagnostics task prints task stack and heap
                statistics, in milliseconds.

        choice DTESP_LOG_LEVEL
            prompt "DECtalk log level"
            default DTESP_LOG_LEVEL_ERROR
            help
                Select the runtime log level used by the DECtalk ESPress
                application, serial transport, and optional diagnostics task.

                Higher log levels provide more detail for debugging, while
                lower levels reduce console output on UART0.

            config DTESP_LOG_LEVEL_ERROR
                bool "Error"
                help
                    Log only errors that prevent normal operation.

            config DTESP_LOG_LEVEL_WARN
                bool "Warning"
                help
                    Log warnings and errors.

            config DTESP_LOG_LEVEL_INFO
                bool "Info"
                help
                    Log normal status messages, warnings, and errors.

            config DTESP_LOG_LEVEL_DEBUG
                bool "Debug"
                help
                    Add debug-level messages that help diagnose protocol and
                    transport behavior.

            config DTESP_LOG_LEVEL_VERBOSE
                bool "Verbose"
                help
                    Enable the most detailed logging level for deep debugging.
        endchoice
    endmenu

endmenu
