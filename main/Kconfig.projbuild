menu "DECtalk ESPress Firmware"

    menu "Audio output"
        choice DECTALK_DAC_TYPE
            prompt "Audio DAC"
            default DECTALK_DAC_GENERIC
            help
                Select the audio DAC or amplifier board connected to the
                I2S output.

            config DECTALK_DAC_GENERIC
                bool "Generic I2S DAC (MAX98357A, PCM5102, etc.)"
                help
                    Simple I2S DAC or amplifier that requires no I2C
                    configuration.  Suitable for MAX98357A, PCM5102,
                    and similar boards that derive their clocks from
                    BCLK and WS alone.

            config DECTALK_DAC_TLV320DAC3100
                bool "Adafruit TLV320DAC3100 breakout"
                help
                    TI TLV320DAC3100 stereo DAC with headphone amplifier
                    and class-D speaker output (Adafruit breakout board).
                    Requires I2C for register configuration.  MCLK is not
                    needed; the codec derives its clock from BCLK.
        endchoice

        config DECTALK_I2S_SAMPLE_RATE
            int "I2S sample rate (Hz)"
            default 11025
            range 8000 48000
            help
                Audio sample rate used for the I2S output.

        config DECTALK_I2S_BCK_GPIO
            int "I2S BCK GPIO"
            default 8
            range 0 48
            help
                GPIO used for the I2S bit clock output.

        config DECTALK_I2S_WS_GPIO
            int "I2S WS GPIO"
            default 3
            range 0 48
            help
                GPIO used for the I2S word select / LRCK output.

        config DECTALK_I2S_DO_GPIO
            int "I2S data out GPIO"
            default 18
            range 0 48
            help
                GPIO used for the I2S serial data output.

        config DECTALK_I2C_SDA_GPIO
            int "I2C SDA GPIO"
            default 1
            range 0 48
            depends on DECTALK_DAC_TLV320DAC3100
            help
                GPIO used for the I2C data line to the TLV320DAC3100.

        config DECTALK_I2C_SCL_GPIO
            int "I2C SCL GPIO"
            default 2
            range 0 48
            depends on DECTALK_DAC_TLV320DAC3100
            help
                GPIO used for the I2C clock line to the TLV320DAC3100.

        config DECTALK_TLV320_I2C_ADDR
            hex "TLV320DAC3100 I2C address"
            default 0x18
            depends on DECTALK_DAC_TLV320DAC3100
            help
                7-bit I2C address of the TLV320DAC3100.  The Adafruit
                breakout board defaults to 0x18.

        menu "TLV320DAC3100 defaults"
            depends on DECTALK_DAC_TLV320DAC3100

            comment "More sound-shaping options may be added later after hardware tuning is validated."

            choice DECTALK_TLV320_DEFAULT_PROFILE
                prompt "Default output profile"
                default DECTALK_TLV320_DEFAULT_PROFILE_SPEAKER
                help
                    Select the startup output profile used before optional
                    headset auto-switching changes it.  Speaker keeps the
                    current safe default.  Low-level DSP and register tuning
                    are intentionally not exposed here yet.

                config DECTALK_TLV320_DEFAULT_PROFILE_SPEAKER
                    bool "Speaker"

                config DECTALK_TLV320_DEFAULT_PROFILE_HEADPHONE
                    bool "Headphone"
            endchoice

            config DECTALK_TLV320_HEADSET_AUTOSWITCH
                bool "Enable headset auto-switching"
                default y
                help
                    Poll the codec headset-detect status and automatically
                    switch between speaker and headphone profiles.

                    Enable this to keep the current behavior.  Disable it to
                    leave the startup/default profile active until software
                    changes it manually.  Jack-detect tuning is intentionally
                    not exposed yet.

            config DECTALK_TLV320_STARTUP_VOLUME
                int "Startup digital volume"
                range 0 9
                default 6
                help
                    Startup digital volume level applied once during codec
                    initialization (0 = near mute, 9 = 0 dB).

                    The default is a conservative startup level and is set to 6
                    because it more closely matches the driver's previous
                    startup gain (about -10 dB).

                    Fine-grained dB, analog gain, EQ, DSP, and register-level
                    tuning are intentionally not exposed yet.
        endmenu

        menu "Advanced audio tuning"
            config DECTALK_I2S_DMA_DESC_NUM
                int "I2S DMA descriptor count"
                default 8
                range 2 32
                help
                    Number of DMA descriptors allocated for I2S playback.

            config DECTALK_I2S_DMA_FRAME_NUM
                int "I2S DMA frame count"
                default 256
                range 64 1024
                help
                    Number of audio frames per I2S DMA descriptor.
        endmenu
    endmenu

    menu "Runtime tuning"
        config DECTALK_TEXT_BUFFER_SIZE
            int "Protocol text buffer size"
            default 2048
            range 256 8192
            help
                Maximum number of text bytes buffered before they are queued
                for synthesis.

        config DECTALK_SPEECH_QUEUE_SIZE
            int "Speech queue depth"
            default 32
            range 4 128
            help
                Number of queued text chunks allowed before host flow control
                starts throttling input.

        config DECTALK_RX_TIMEOUT_MS
            int "Serial RX timeout (ms)"
            default 10
            range 1 1000
            help
                Timeout used when polling the serial receive buffer.

        config DECTALK_TEXT_IDLE_TIMEOUT_MS
            int "Buffered text idle flush timeout (ms)"
            default 200
            range 10 5000
            help
                Flush buffered text to the speech queue if no new characters
                arrive within this interval.

        menu "Advanced task tuning"
            config DECTALK_SPEECH_TASK_CORE
                int "Speech task core"
                default 1 if SOC_CPU_CORES_NUM > 1
                default 0
                range 0 1 if SOC_CPU_CORES_NUM > 1
                range 0 0
                help
                    CPU core used for the speech synthesis thread.
                    On single-core chips this is fixed to core 0.

            config DECTALK_MAIN_TASK_STACK_SIZE
                int "Main ESPress pthread stack size"
                default 12288
                range 4096 32768
                help
                    Stack size for the ESPress protocol thread created from
                    app_main().
        endmenu
    endmenu

    menu "USB CDC transport"
        visible if !IDF_TARGET_ESP32C6
        config DECTALK_CDC_RX_STREAM_SIZE
            int "CDC RX stream buffer size"
            default 4096
            range 256 16384
            help
                Size of the FreeRTOS stream buffer that bridges TinyUSB RX to
                the ESPress protocol task.
    endmenu

    menu "JTAG serial transport"
        visible if IDF_TARGET_ESP32C6
        config DECTALK_JTAG_RX_BUF_SIZE
            int "JTAG serial RX buffer size"
            default 4096
            range 256 16384
            help
                Size of the ring buffer for USB Serial/JTAG receive data.

        config DECTALK_JTAG_TX_BUF_SIZE
            int "JTAG serial TX buffer size"
            default 4096
            range 256 16384
            help
                Size of the ring buffer for USB Serial/JTAG transmit data.
    endmenu

    menu "Onboard RGB LED"
        config DECTALK_DISABLE_RGB_LED
            bool "Disable onboard RGB LED"
            default n
            help
                Many ESP32 development boards include an onboard addressable
                RGB LED (WS2812 / SK6812).  Enable this option to drive the
                LED data GPIO low at startup, keeping the LED dark.

                Not all boards have an RGB LED, so this option is disabled
                by default.

        config DECTALK_RGB_LED_GPIO
            int "RGB LED data GPIO"
            depends on DECTALK_DISABLE_RGB_LED
            default 8  if IDF_TARGET_ESP32C6
            default 18 if IDF_TARGET_ESP32S2
            default 48
            range 0 48
            help
                GPIO connected to the onboard addressable RGB LED data input.

                Common defaults:
                  ESP32-C6  – GPIO 8
                  ESP32-S2  – GPIO 18
                  ESP32-S3  – GPIO 48
    endmenu

    menu "Diagnostics and logging"
        config DECTALK_ENABLE_DIAG_MEM
            bool "Enable heap and stack diagnostics"
            default n
            select FREERTOS_USE_TRACE_FACILITY
            help
                Start a low-priority background task that periodically logs
                per-task stack high-water marks together with heap usage and
                fragmentation statistics.

                Disable this option to remove the diagnostic task entirely
                when you want the quietest runtime logging or the lowest
                possible overhead.

        choice DECTALK_LOG_LEVEL
            prompt "DECtalk log level"
            default DECTALK_LOG_LEVEL_ERROR
            help
                Select the runtime log level used by the DECtalk ESPress
                application, serial transport, and optional diagnostics task.

                Higher log levels provide more detail for debugging, while
                lower levels reduce console output on UART0.

            config DECTALK_LOG_LEVEL_ERROR
                bool "Error"
                help
                    Log only errors that prevent normal operation.

            config DECTALK_LOG_LEVEL_WARN
                bool "Warning"
                help
                    Log warnings and errors.

            config DECTALK_LOG_LEVEL_INFO
                bool "Info"
                help
                    Log normal status messages, warnings, and errors.

            config DECTALK_LOG_LEVEL_DEBUG
                bool "Debug"
                help
                    Add debug-level messages that help diagnose protocol and
                    transport behavior.

            config DECTALK_LOG_LEVEL_VERBOSE
                bool "Verbose"
                help
                    Enable the most detailed logging level for deep debugging.
        endchoice
    endmenu

endmenu
